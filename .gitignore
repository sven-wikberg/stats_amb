# Environnements et caches Python locaux.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
tests/tmp/*
!tests/tmp/.gitkeep
/tmp/
/tmp*/

# Les exports contiennent des données opérationnelles : ils restent locaux par
# défaut. Les fichiers déjà suivis par Git ne sont pas supprimés par cette règle.
data/*.csv
data/*.xlsx
data/*.xlsm

# Les rapports et graphiques sont reproductibles à partir des données sources.
output/*.pdf
output/*.png
output/graphs/
