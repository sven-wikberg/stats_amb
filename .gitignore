# Environnements et caches Python locaux.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
tests/tmp/*
!tests/tmp/.gitkeep
/tmp/
/tmp*/

# Les exports contiennent des données opérationnelles sensibles et restent
# strictement locaux. Le dossier complet est donc exclu du dépôt.
/data/

# Les rapports et graphiques sont reproductibles à partir des données sources.
/output/
